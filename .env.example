# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real keys to GitHub.

# A passcode you choose. Anyone using the app types this once on their phone.
APP_PASSCODE=

# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5. Use claude-haiku-5-5 for cheaper/faster.
ANTHROPIC_MODEL=

# From elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=
# From elevenlabs.io → Voices → your cloned voice → copy Voice ID
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2 (best quality).
# eleven_flash_v2_5 uses about half the credits.
ELEVENLABS_MODEL=
